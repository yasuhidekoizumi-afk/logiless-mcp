# Logiless HTTP MCP Server Configuration
# Copy this to .env and fill in your values

# Required: LOGILESS API credentials
LOGILESS_ACCESS_TOKEN=your_access_token_here
LOGILESS_MERCHANT_ID=your_merchant_id_here

# Required for HTTP mode: shared API key for team access
LOGILESS_MCP_API_KEY=generate_a_random_secret_key

# Optional: HTTP server port (default: 3938)
LOGILESS_MCP_PORT=3938
